generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model topics {
  id            String          @id @db.VarChar(255)
  label         String          @db.VarChar(255)
  level         String          @db.VarChar(50)
  category      String          @db.VarChar(100)
  description   String
  key_takeaway  String
  prerequisites Json            @default("[]")
  resources     Json            @default("[]")
  position_x    Float           @db.Real
  position_y    Float           @db.Real
  how_to        Json            @default("[]")
  user_progress user_progress[]
}

model user_progress {
  id           String   @id @db.VarChar(36)
  user_id      String   @db.VarChar(36)
  topic_id     String   @db.VarChar(255)
  is_completed Boolean  @default(false)
  updated_at   DateTime @default(now()) @db.Timestamp(6)
  topics       topics   @relation(fields: [topic_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_progress_topic_id_topics_id_fk")
  users        users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_progress_user_id_users_id_fk")
}

model users {
  id            String          @id @db.VarChar(36)
  username      String          @unique(map: "users_username_unique") @db.VarChar(255)
  password_hash String          @db.VarChar(255)
  created_at    DateTime        @default(now()) @db.Timestamp(6)
  user_progress user_progress[]
}

enum LeaveType {
  PERSONAL
  ANNUAL
  SICK
}

model Leave {
  id        String    @id @default(uuid())
  name      String
  type      LeaveType
  startDate DateTime
  endDate   DateTime
  note      String?
  createdAt DateTime  @default(now())
}

